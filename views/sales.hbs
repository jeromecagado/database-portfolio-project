<table id="sale-table">
     <style>
            body {
                display: flex;
                flex-direction: column;  
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            th, td {
                border: 1px solid black;
                padding: 8px;
                text-align: center;
            }
            th {
                background-color: #f2f2f2;
                text-align: center;
                width: 100px;
            }
            h1 {
                text-align: center;
            }
            tr {
                text-align: center;
            }
        </style>
    {{!-- Header section --}}

    <h2>Sales</h2>
    <thead>
        {{!-- For just the first row, we print each key of the row object as a header cell so we
        know what each column means when the page renders --}}
        {{!-- This Section was our code, because we wanted the tables to look a certain way. --}}
        <tr>
            <th>ID</th>
            <th>Employee</th>            
            <th>Customer</th>
            <th>Revenue</th>
            <th>Sold</th>
            <th>Delete</th>
        </tr>
        </tr>
    </thead>

    <tbody>

        {{!-- For each row, print the sale id, employee id, customer id, and sale revenue in order --}}
        {{#each data}}
        <tr data-value={{this.sale_id}}>
            <td>{{this.sale_id}}</td>
            <td> ID: {{this.employee_id}} - Name: {{this.employee_fname}} {{this.employee_lname}}</td>
            <td>ID: {{this.customer_id}} - Name: {{this.customer_fname}} {{this.employee_lname}}</td>
            <td>$ {{this.sale_revenue}}</td>
        
         {{!-- The following formatDate was used because of Cuong Duong's suggestion to use moment with handlebars in the ed discussion reflected in the readme.
         Source URL: https://edstem.org/us/courses/49750/discussion/4477591--}}
            <td>{{formatDate this.sold_date 'MMM DD, YYYY'}}</td>
            
            <td><button onclick="deleteSale({{this.sale_id}})">Delete</button></td>
        </tr>
        {{/each}}
    </tbody>
</table>

<script src="./js/delete_sale.js"></script>

<h2>Add a Sale</h2>
<p>To add a new Sale, please enter their information below and click 'Submit'!</p>
<form id="add-sale-form-ajax">
    <label for="input-employee_id">Employee: </label>
    <select name="input-employee_id" id="input-employee_id">
                {{#each employees}}
                <option value="{{this.employee_id}}">{{this.employee_fname}} {{this.employee_lname}}</option>
                {{/each}}
            </select>
    
    <label for="input-customer_id">Customer: </label>
    <select name="input-customer_id" required id="input-customer_id">
                {{#each customers}}
                <option value="{{this.customer_id}}">{{this.customer_fname}} {{this.customer_lname}}</option>
                {{/each}}
            </select>
    <label for="input-sale_revenue">sale_revenue </label>
    <input type="number" name="input-sale_revenue" required id="input-sale_revenue">
    
    <label for="input-sold_date">Sold Date </label>
    <input type="date" name="input-sold_date" id="input-sold_date">

    <input type="submit">
</form>

{{!-- The following script, was needed to ensure dynamic adding with the correct formatted date. This was copied from source. 
Source URL: https://cdnjs.com/libraries/moment.js--}}
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script src="./js/add_sale.js"></script>