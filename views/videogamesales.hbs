<table id="videogamesales-table">
     <style>
            body {
                display: flex;
                flex-direction: column;  
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            th, td {
                border: 1px solid black;
                padding: 8px;
                text-align: center;
            }
            th {
                background-color: #f2f2f2;
                text-align: center;
                width: 100px;
            }
            h1 {
                text-align: center;
            }
            tr {
                text-align: center;
            }
        </style>
    {{!-- Header section --}}

    <h2>Video Game Sales</h2>

    <thead>
      {{!-- This Section was our code, because we wanted the tables to look a certain way. --}}
        <tr>
            <th>ID</th>
            <th>Sale ID</th>
            <th>Customer Name</th>
            <th>Date of Sale</th>
            <th>Video Game ID</th>
            <th>Video Game Name</th>
            <th>Delete</th>
        </tr>
    </thead>

    <tbody>

        {{!-- For each row, print the id's for videogamesales, saleid, and videogame id in order --}}
        {{#each data}}
        <tr data-value={{this.video_games_sales_id}}>
            <td>{{this.video_games_sales_id}}</td>
            <td>{{this.sale_id}}</td>
            <td>{{this.customer_fname}} {{this.customer_lname}}</td>
            <td>{{formatDate this.sold_date 'MMM DD, YYYY'}}</td>
            <td>{{this.video_game_id}}</td>
            <td>{{this.video_game_name}}</td>
            <td><button onclick="deleteVideoGameSale({{this.video_games_sales_id}})">Delete</button></td>
        </tr>
        {{/each}}
    </tbody>
</table>
<script src="./js/delete_videogamesale.js"></script>


<h2>Add a Sale</h2>
<p>To add a new Sale, please enter their information below and click 'Submit'!</p>
<form id="add-videogamesale-form-ajax">
    <label for="input-sale_id">Customer and Date: </label>
    <select name="input-sale_id" id="input-sale_id">
                {{#each sales}}
                <option value="{{this.sale_id}}">Sale ID: {{this.sale_id}} <strong> - Customer: {{this.customer_fname}} {{this.customer_lname}} - Date of Sale: {{formatDate this.sold_date 'MMM DD, YYYY'}} </option>
                {{/each}}
            </select>
    <label for="input-videogame_id">Video Game: </label>
    <select name="input-videogame_id" id="input-videogame_id">
                {{#each videogames}}
                <option value="{{this.video_game_id}}">{{this.video_game_name}}</option>
                {{/each}}
            </select>
    <input type="submit">
</form>
{{!-- The following script, was needed to ensure dynamic adding with the correct formatted date. This was copied from source.  
Source URL: https://cdnjs.com/libraries/moment.js--}}
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script src="./js/add_videogamesale.js"></script>
