<table id="employee-table">
     <style>
            body {
                display: flex;
                flex-direction: column;  
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            th, td {
                border: 1px solid black;
                padding: 8px;
                text-align: center;
            }
            th {
                background-color: #f2f2f2;
                text-align: center;
                width: 100px;
            }
            h1 {
                text-align: center;
            }
            tr {
                text-align: center;
            }
        </style>
    {{!-- Header section --}}

    <h2>Employees</h2>
    <thead>
        {{!-- For just the first row, we print each key of the row object as a header cell so we
        know what each column means when the page renders --}}
        {{!-- This Section was our code, because we wanted the tables to look a certain way. --}}
        <tr>
            <th>ID</th>            
            <th>First Name</th>
            <th>Last Name</th>
            <th>Phone</th>
            <th>Hire Date</th>
            <th>Delete</th>
        </tr>
    </thead>

    <tbody>

        {{!-- For each row, print the id, fname, lname, and phone in order --}}
        {{#each data}}
        <tr data-value={{this.employee_id}}>
            <td>{{this.employee_id}}</td>
            <td>{{this.employee_fname}}</td>
            <td>{{this.employee_lname}}</td>
            <td>{{this.employee_phone}}</td>
        {{!-- The following formatDate was used because of Cuong Duong's suggestion to use moment with handlebars in the ed discussion reflected in the readme.
        Source URL: https://edstem.org/us/courses/49750/discussion/4477591--}}
            <td>{{formatDate this.hire_date 'MMM DD, YYYY'}}</td>
            
            <td><button onclick="deleteEmployee({{this.employee_id}})">Delete</button></td>
        </tr>
        {{/each}}
    </tbody>
</table>
<script src="./js/delete_employee.js"></script>


<h2>Add an Employee</h2>
<p>To add a new Employee, please enter their information below and click 'Submit'!</p>
<form id="add-employee-form-ajax">
    <label for="input-employee_fname">First Name: </label>
    <input type="text" name="input-employee_fname" id="input-employee_fname">
    
    <label for="input-employee_lname">Last Name </label>
    <input type="text" name="input-employee_lname" id="input-employee_lname">

    <label for="input-employee_phone">Phone: </label>
    <input type="number" name="input-employee_phone" id="input-employee_phone" maxlength="20">
    
    <label for="input-employee_hiredate">Hire Date </label>
    <input type="date" name="input-employee_hiredate" id="input-employee_hiredate">

    <input type="submit">
</form>
{{!-- The following script, was needed to ensure dynamic adding with the correct formatted date. This was copied from source.  
Source URL: https://cdnjs.com/libraries/moment.js--}}
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script src="./js/add_employee.js"></script>
