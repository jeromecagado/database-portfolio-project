<table id="videogame-table">
     <style>
            body {
                display: flex;
                flex-direction: column;  
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            th, td {
                border: 1px solid black;
                padding: 8px;
                text-align: center;
            }
            th {
                background-color: #f2f2f2;
                text-align: center;
                width: 100px;
            }
            h1 {
                text-align: center;
            }
            tr {
                text-align: center;
            }
        </style>
    {{!-- Header section --}}

    <h2>Video Games</h2>
    <thead>
        {{!-- For just the first row, we print each key of the row object as a header cell so we
        know what each column means when the page renders --}}
        {{!-- This Section was our code, because we wanted the tables to look a certain way. --}}
        <tr>
            <th>ID</th>            
            <th>Developer</th>
            <th>Videogame</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Delete</th>
        </tr>
    </thead>

    <tbody>

        {{!-- For each row, print the videogame id, developer id, videogame name, price and quantity in order --}}
        {{#each data}}
        <tr data-value={{this.video_game_id}}>
            <td>{{this.video_game_id}}</td>
            <td>{{this.developer_id}}</td>
            <td>{{this.video_game_name}}</td>
            <td>{{this.price}}</td>
            <td>{{this.quantity}}</td>
            <td><button onclick="deleteVideogame({{this.video_game_id}})">Delete</button></td>
        </tr>
        {{/each}}
    </tbody>
</table>
<script src="./js/delete_videogame.js"></script>


{{!-- Form to add a record to the table  --}}
<h2>Add a Videogame</h2>
<p>To add a new videogame, please enter their information below and click 'Submit'!</p>
<form id="add-videogame-form-ajax">
    <label for="input-developer">Developer: </label>
    <select name ="input-developer_id" id="input-developer_id">
        <option value="test">Select a Developer</option>
        {{#each developers}}
        <option value="{{this.developer_id}}">{{this.developer_name}}</option>
        {{/each}}
    </select>
    
    <label for="input-video_game_name">Videogame Name:</label>
    <input type="text" name="input-video_game_name" required id="input-video_game_name">

    <label for="input-price">Price: </label>
    <input type="text" name="input-price" required id="input-price">

    <label for="input-quantity">Quantity: </label>
    <input type="text" name="input-quantity" required id="input-quantity">

    <input type="submit">
</form>

{{!-- Embed our javascript to handle the DOM manipulation and AJAX request --}}
<script src="./js/add_videogame.js"></script>
