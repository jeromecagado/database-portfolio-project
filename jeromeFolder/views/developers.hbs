{{!-- Create a table --}}

<table id="developer-table">
     <style>
            body {
                display: flex;
                flex-direction: column;  
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            th, td {
                border: 1px solid black;
                padding: 8px;
                text-align: center;
            }
            th {
                background-color: #f2f2f2;
                text-align: center;
                width: 100px;
            }
            h1 {
                text-align: center;
            }
            tr {
                text-align: center;
            }
        </style>
    {{!-- Header section --}}
    <thead>
        {{!-- For just the first row, we print each key of the row object as a header cell so we
        know what each column means when the page renders --}}
        <tr>
            {{#each data.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th>delete</th>
        </tr>
    </thead>

    {{!-- Body section --}}
    <tbody>

        {{!-- For each row, print the id, name, country, and email in order --}}
        {{#each data}}
        <tr data-value={{this.developer_id}}>
            <td>{{this.developer_id}}</td>
            <td>{{this.developer_name}}</td>
            <td>{{this.developer_country}}</td>
            <td>{{this.developer_email}}</td>
            <td><button onclick="deleteDeveloper({{this.developer_id}})">Delete</button></td>
        </tr>
        {{/each}}
    </tbody>
</table>
<script src="./js/delete_developer.js"></script>
<!-- /views/index.hbs -->

{{!-- Form to add a record to the table  --}}
<h2>Add a Developer</h2>
<p>To add a new developer, please enter their information below and click 'Submit'!</p>
<form id="add-developer-form-ajax">
    <label for="input-developer_name">Developer Name: </label>
    <input type="text" name="input-developer_name" id="input-developer_name">
    
    <label for="input-developer_country">Country: </label>
    <input type="text" name="input-developer_country" id="input-developer_country">

    <label for="input-developer_email">Email: </label>
    <input type="text" name="input-developer_email" id="input-developer_email">

    <input type="submit">
</form>

<h2>Update a Developer</h2>
<form id="update-developer-form-ajax">
    <label for="input-developer_name">Developer Name: </label>
    <select name="input-developer_name-update" id="input-developer_name">
        <option value="test">Select a Developer</option>
        {{#each data}}
        <option value="{{this.developer_id}}">{{this.developer_name}}</option>
        {{/each}}
    </select>
    <label for="input-developer_country">Country: </label>
    <input type="text" name="input-developer_country" id="input-developer_country">

    <label for="input-developer_email">Email: </label>
    <input type="text" name="input-developer_email" id="input-developer_email">
    <input type="submit">
</form>

<script src="./js/update_developer.js"></script>


{{!-- Embed our javascript to handle the DOM manipulation and AJAX request --}}
<script src="./js/add_developer.js"></script>